body {
  background: linear-gradient(135deg, #e0f7fa, #80deea);
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.container {
  padding: 30px;
}

.card-custom {
  border-radius: 15px !important;
  box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease;
}

.card-custom:hover {
  transform: scale(1.05);
}

.card-priority-high {
  border-left: 5px solid #dc3545 !important; /* Bootstrap danger */
}

.card-priority-medium {
  border-left: 5px solid #ffc107 !important; /* Bootstrap warning */
}

.card-priority-low {
  border-left: 5px solid #0d6efd !important; /* Bootstrap primary */
}

.task-icon {
  font-size: 1.5rem;
  margin-right: 8px;
}

.card-title.done {
  text-decoration: line-through;
  color: #6c757d;
}

.task-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10px;
}
